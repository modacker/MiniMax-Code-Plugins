{
  "name": "mcode-webui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "v2.0.0 industrializes the v1.x surface with append-only event stream + hash chain, independent anomaly SSE channel, per-request authorize() gate, interaction/feedback subsystem split, plugin metadata drift detector, CI matrix + SBOM + CVE, rate limiting, virtual chat list, cross-workspace session search, session export (Markdown / JSON), quota forecast, and token-onboarding modal. Zero npm dependencies; runs on Node 22+.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --experimental-test-module-mocks --test test/*.test.js",
    "check": "node scripts/check-docs-alignment.mjs",
    "check:ci": "node scripts/check-docs-alignment.mjs --ci",
    "sbom": "node scripts/gen-sbom.mjs",
    "coverage": "c8 --reporter=text --reporter=lcov node --experimental-test-module-mocks --test test/*.test.js",
    "lint": "eslint server/ test/",
    "format": "prettier --write server/ test/",
    "setup:plugin": "node scripts/setup-plugin-layout.mjs",
    "package:plugin": "node scripts/package-plugin.mjs"
  },
  "engines": {
    "node": ">=22.19 <23 || >=24 <27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "c8": {
    "include": [
      "server/**/*.js"
    ],
    "exclude": [
      "server/lib/mcode-acp.js",
      "server/lib/mcode-exec.js",
      "server/lib/mcode-rpc.js",
      "server/acp.mjs"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
